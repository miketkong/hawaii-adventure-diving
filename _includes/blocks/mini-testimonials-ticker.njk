<div id="mini-testimonials-ticker"></div>
<script>
  var ticker = document.currentScript.previousElementSibling;
  var testimonials = [
    '"Truly a life changing experience."',
    '"Thanks for being so amazing and welcoming."',
    '"Very professional team, we felt very safe."',
    '"Top-tier staff are highly knowledgeable."',
    '"10/10 recommend!!!"',
    '"Our photos turned out EPIC!"',
    '"Amazing guides, unbelievable experience!"',
    '"We swam with a 15 foot tiger shark."'
  ];
  var current = Math.floor(Math.random() * testimonials.length);
  ticker.textContent = testimonials[current];
  setInterval(function () {
    ticker.style.opacity = '0';
    setTimeout(function () {
      var next;
      do { next = Math.floor(Math.random() * testimonials.length); } while (next === current);
      current = next;
      ticker.textContent = testimonials[current];
      ticker.style.opacity = '1';
    }, 600);
  }, 4000);
</script>
<section id="big-footer-cta">
<div class="content-wrap big-CTA-pre-footer big-CTA-pre-footer-v2">
    <!-- Call to action-->
    <div class="position-relative">
        <div class="half-section-block container position-absolute top-50 start-0 end-0" data-prev-id=".footerPrev" data-next-id=".footerNext">
            <div class="shape-parent">
                <div class="py-80 px-30 position-relative rounded-4 overflow-hidden z-index-1">
                    <div class="background">
                        <div class="background-image jarallax" data-jarallax data-speed="0.8"><img class="jarallax-img" loading="lazy" src="/assets/img/root/call-to-action-1920x1080.jpg" alt=""></div>
                        <div class="background-color" style="--background-color: #064175; opacity: .9;"></div>
                    </div>
                    <div class="row">
                        <div class="col-lg-8 offset-lg-2 text-center">
                            <img class="mb-50 logo w-sm-100" src="/images/header-logo-400px.png" alt="Hawaii Adventure Diving">
                            <!--<h2 class="pb-40 text-white">Now it's <span class="no-break"><span class="hand-underline-yellow">Your</span> Turn.</span></h2>-->
                            <!--<h2 class="pb-40 text-white">The Sharks <span class="no-break">Are <span class="hand-underline-yellow">Waiting</span>.</span></h2>-->
                            <h2 class="pb-40 text-white mobile">The Ultimate <span class="no-break">Shark Diving</span> Experience.</h2>
                            <h2 class="pb-40 text-white desktop">The Ultimate Shark <span class="no-break">Diving Experience.</span></h2>
                            <!--<p class="mb-50 text-white px-lg-70" data-show-delay="100">Reserve your spot today and experience cage-free shark diving with <span class="no-break">Hawaii Adventure Diving.</span></p>-->
                            <p class="mb-50 text-white px-lg-70" data-show-delay="100">Book your <span class="no-break">adventure today.</span></p>
                            <div>
                                <!-- Button-->
                                {{ btn | safe }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--// Call to action -->
</div>
</section>
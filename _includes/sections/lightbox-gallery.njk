<script type="text/javascript">
    // Gallery Items script for lightbox gallery
    const galleryItems = [
        
        'shark-divers-chasing',
        'pink-shark-diver',
        'beautiful-woman-free-diving-with-sharks-hawaii-shark-tour',
        'couple-swimming-with-sharks-without-cage-hawaii-oahu',
        'female-diver-with-shark-striped-2',
        'female-diver-with-shark-striped',
        'snorkeler-on-rope-with-shark',
        'fun-hawaii-shark-diving',
        'shark-diving-hawaii-2',
        'beautiful-shark-diver-hawaii',
        'couple-shark-diving-hawaii',
        'diver-posing-with-shark',
        'divers-and-shark-hawaii',
        'divers-swimming-with-a-shark',
        'diving-down-with-shark-hawaii',
        'hawaii-shark-diving-tour-photo',
        'morning-sun-shark-dive',
        'shark-dive-morning-sun',
        'shark-diving-hawaii-camera',
        'snorkeler-and-3-sharks',
        'swimming-after-shark-hawaii',
        'swimming-with-a-shark',
        'swimming-with-shark-in-hawaii',
        'two-divers-and-shark-hawaii',
    ];

    function buildGallery() {
        const galleryWrapper = document.querySelector('.gallery-wrapper');
        galleryItems.forEach(item => {
            const galleryItem = document.createElement('a');
            galleryItem.classList.add('gallery-item');
            galleryItem.href = `/images/lightbox-galleries/shark-tour-lp-photos-section/${item}.jpg`;

            const img = document.createElement('img');
            img.src = `/images/lightbox-galleries/shark-tour-lp-photos-section/thumbs/tn_${item}.jpg`;
            img.alt = `Shark diving photo: ${item.replace(/-/g, ' ').replace(/\.[^/.]+$/, '')}`;

            galleryItem.appendChild(img);
            galleryWrapper.appendChild(galleryItem);
        });
    }
    document.addEventListener('DOMContentLoaded', buildGallery);
</script>